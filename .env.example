# ============================================================================
# .env.example
# ============================================================================


# === APP SETTINGS ===
ENVIRONMENT=development
DEBUG=true
APP_NAME="Kukekodes Learning Platform"
APP_VERSION="1.0.0"

# === DATABASE ===
# PostgreSQL (Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/kukekodes

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kukekodes_analytics

# === REDIS (Optional) ===
REDIS_URL=redis://localhost:6379/0

# === JWT & SECURITY ===
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# === EXTERNAL APIs ===
# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@kukekodes.com

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini (for AI Coach)
GEMINI_API_KEY=your_gemini_api_key_here

# === EMAIL SETTINGS ===
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_RESET_EXPIRE_MINUTES=30

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_AUTH_REQUESTS=5

