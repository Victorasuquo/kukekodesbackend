# ============================================================================
# .env.example
# ============================================================================


# === APP SETTINGS ===
ENVIRONMENT=production
DEBUG=false
APP_NAME="Kukekodes Learning Platform"
APP_VERSION="1.0.0"
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
FORWARDED_ALLOW_IPS=*
APP_ENV_FILE=.env.example
AUTO_CREATE_TABLES=false
TRUSTED_HOSTS=["api.example.com","localhost","127.0.0.1"]

# === DATABASE ===
# PostgreSQL (Supabase)
DATABASE_URL=postgresql://supabase_user:replace-with-database-password@db.example.supabase.co:5432/postgres?sslmode=require

# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kukekodes_analytics

# === PRIVATE JOB QUEUE ===
# REDIS_URL is assembled by docker-compose for private service-to-service use.
REDIS_PASSWORD=replace-with-a-long-random-password
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=200

# === JWT & SECURITY ===
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# === CORS ===
CORS_ORIGINS=["https://app.example.com","http://localhost:5173","http://127.0.0.1:5173"]

# === EXTERNAL APIs ===
# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@kukekodes.com

# Resend (target provider for transactional and reminder emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=KukeKodes <noreply@example.com>
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Gemini (for AI Coach)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === EMAIL SETTINGS ===
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_RESET_EXPIRE_MINUTES=30

# === LOGGING ===
LOG_LEVEL=INFO
LOG_FORMAT=json

# === RATE LIMITING ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_AUTH_REQUESTS=5
